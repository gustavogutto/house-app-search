# Vercel Marketplace Postgres (Neon) — auto-injected once provisioned, or `vercel env pull`
DATABASE_URL=

# Postmark (inbound parsing + outbound email) — https://postmarkapp.com
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Basic Auth creds embedded in the Postmark inbound webhook URL, e.g.
# https://USER:PASS@yourapp.vercel.app/api/inbound-email
POSTMARK_INBOUND_WEBHOOK_USER=
POSTMARK_INBOUND_WEBHOOK_PASS=

# Web Push — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Twilio SMS — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Auth — each person's login is created with `npm run set-password -- "email" "password"`
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Auto-injected by Vercel Cron — do not set manually in production
CRON_SECRET=

# Vercel Marketplace Postgres (Neon) — auto-injected once provisioned, or `vercel env pull`
DATABASE_URL=

# Resend (inbound email parsing + outbound notification email) — https://resend.com
# Free managed inbound address (no domain needed): something@your-name.resend.app
RESEND_API_KEY=
# From the webhook's settings page in the Resend dashboard (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Leave as onboarding@resend.dev unless you've verified your own domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev

# Web Push — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Twilio SMS — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Auth — each person's login is created with `npm run set-password -- "email" "password"`
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Auto-injected by Vercel Cron — do not set manually in production
CRON_SECRET=
